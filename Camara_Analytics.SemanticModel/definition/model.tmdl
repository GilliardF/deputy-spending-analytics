model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["AnoInicial","AnoFinal","fxObterDespesasPorAno","F_Despesas","D_Deputado","D_TipoDespesa","D_Fornecedor"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.138.1004.0 (24.11)

ref table F_Despesas
ref table D_Deputado
ref table D_Calendario
ref table D_TipoDespesa
ref table D_Fornecedor
ref table D_Benford
ref table _Medidas

ref expression AnoInicial
ref expression AnoFinal
ref expression fxObterDespesasPorAno

ref cultureInfo pt-BR
